# SSH Notification Configuration
# Copy this file to /etc/ssh/scripts/notify.conf and edit as needed

# Discord webhook URL
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/your-webhook-id/your-webhook-token"

# Excluded subnets (space-separated list)
# You can use simple IP prefixes like "10.0.1" to match any IP starting with that prefix
EXCLUDED_SUBNETS="10.0.1 192.168"
